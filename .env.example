# Public Supabase credentials from the Supabase Connect / API panel.
# Never put SUPABASE_SERVICE_ROLE_KEY or a database password in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# URL of the local or deployed NUMELYRA Next.js backend.
EXPO_PUBLIC_API_URL=http://192.168.1.19:3200

# Public Cloudflare R2 custom domain for calendar art. No R2 key is needed in the app.
EXPO_PUBLIC_CALENDAR_ASSET_BASE_URL=https://assets.numelyra.online
